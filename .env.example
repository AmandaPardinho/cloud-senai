# Modelo das variaveis de ambiente do perfil prod.
#
# Na instancia EC2, copie para ~/catalogo.env e preencha com os dados reais do RDS:
#     cp .env.example ~/catalogo.env && chmod 600 ~/catalogo.env
#
# O nome catalogo.env importa: e o arquivo que o servico systemd le em
# EnvironmentFile=/home/ec2-user/catalogo.env (ver docs/Infraestrutura na AWS.md, 4.5).
# Este arquivo e apenas um modelo; o arquivo real NAO vai para o repositorio.
DB_HOST=seu-endpoint.xxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=catalogo
DB_USER=postgres
DB_PASSWORD=troque-esta-senha
